# ==============================================================================
# PM SHRI Kendriya Vidyalaya Portal — Environment Variables Reference
# ==============================================================================
# In Render: Go to your Web Service Dashboard > Environment > Add Environment Variable
# Locally : Copy this file to .env and fill in your values
# ==============================================================================

# 1. Supabase Project URL (from Supabase Dashboard > Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public API Key (from Supabase Dashboard > Project Settings > API)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-key-here...

# 3. Portal Administrator Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# 4. Optional Overrides
# PORT=10000
# SCHOOL_NAME="PM SHRI Kendriya Vidyalaya Suranussi"
